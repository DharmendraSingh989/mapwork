# =================================================================
# MapForge Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =================================================================

# Application Mode: development | test | production
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Client Application URL (for CORS and link generation)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mapforge?retryWrites=true&w=majority
# If omitted in development/test, MapForge automatically uses an in-memory MongoDB fallback.
MONGODB_URI=

# JWT Secrets for Authentication (replace with strong random strings in production)
JWT_ACCESS_SECRET=mapforge_super_secure_access_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=mapforge_super_secure_refresh_secret_key_change_in_production_2026

# JWT Expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Map Tile / Style Configuration (MapLibre GL JS compatible)
# Default: Carto Positron or OpenStreetMap standard style
# Free options:
# - Carto Positron: https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# - Carto Dark: https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# - Carto Voyager: https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# - OpenStreetMap Raster: osm-raster
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Geocoding Provider: 'nominatim' (OpenStreetMap free service) | 'custom'
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# Cookie & CORS Settings
COOKIE_ORIGIN=http://localhost:5173

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=20
